# Copy to .env and adjust for your environment.

# Postgres connection. For local Homebrew Postgres this is your macOS user, no password.
DATABASE_URL=postgresql+psycopg2://anshikachauhan@localhost:5432/jobtracker

# Comma-separated list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# LLM via Ollama. Cloud models (fast, no local load) need `ollama signin`.
# For a fully-local/offline setup, use qwen3:4b / qwen3:8b instead.
OLLAMA_URL=http://localhost:11434
# Model for Fetch-JD + ATS keyword extraction.
OLLAMA_MODEL=gpt-oss:20b-cloud
# Model for the compatibility score.
OLLAMA_COMPAT_MODEL=gpt-oss:20b-cloud
